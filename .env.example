# Copy to .env and fill in real values. Never commit .env.

# Anthropic API (https://console.anthropic.com) - used only for the lazy
# vision pass (structural/architecture tags + rationale, on first view)
ANTHROPIC_API_KEY=

# Mapbox Static Images + Geocoding API (https://account.mapbox.com) -
# satellite/location-map imagery, anchor geocoding, and (new) forward
# geocoding of email-sourced listing addresses.
MAPBOX_API_KEY=

# Local Postgres (matches docker-compose.yml); Railway will inject its own
# DATABASE_URL in production.
DATABASE_URL=postgresql://canopy:canopy@localhost:5433/canopy

# Gmail credentials, dual-purpose: SMTP send for the weekly digest AND IMAP
# poll for incoming Zillow alert emails (canopy/clients/gmail.py). Use an
# app password, not your normal account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO_EMAIL=

# Gmail label that a filter routes incoming Zillow alert emails into.
# canopy/clients/gmail.py polls only this label via IMAP.
GMAIL_IMAP_LABEL=canopy-listings
