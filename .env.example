# Copy to .env and fill in real values. Never commit .env.

# Anthropic API (https://console.anthropic.com) - used only for the lazy
# vision pass (structural/architecture tags + rationale, on first view)
ANTHROPIC_API_KEY=

# Mapbox Static Images + Geocoding API (https://account.mapbox.com) -
# satellite/location-map imagery, anchor geocoding, and (new) forward
# geocoding of email-sourced listing addresses.
MAPBOX_API_KEY=

# Local Postgres (matches docker-compose.yml); Railway will inject its own
# DATABASE_URL in production.
DATABASE_URL=postgresql://canopy:canopy@localhost:5433/canopy

# Gmail credentials, dual-purpose: SMTP send for the weekly digest AND IMAP
# poll for incoming Zillow alert emails (canopy/clients/gmail.py). Use an
# app password, not your normal account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO_EMAIL=

# Gmail label that a filter routes incoming Zillow alert emails into.
# canopy/clients/gmail.py polls only this label via IMAP.
GMAIL_IMAP_LABEL=canopy-listings

# RentCast API (https://www.rentcast.io) - restored as a background-only
# weekly-ish feed (canopy/cli.py::run_rentcast_weekly) after being retired
# as the primary listings source. Not required for the app's core
# Zillow-email path; if unset, `run-rentcast` just does nothing useful and
# canopy/rentcast_backfill.py's collation has nothing to match against.
RENTCAST_API_KEY=

# Zips RentCast polls for the background collation feed, and the set a
# Zillow-sourced listing is checked against to flag it "out of area" if
# its geocoded zip isn't in this list. Free tier is 50 calls/month -- see
# canopy/config.py's RENTCAST_MONTHLY_CALL_BUDGET comment before adding
# zips or increasing run-rentcast's cron frequency.
TARGET_ZIPS=28403,28405,28409,28412,28428,28449
