# Copy to .env and fill in real values. Never commit .env.

# RentCast (https://developers.rentcast.io) - free tier: 50 calls/month
RENTCAST_API_KEY=

# Anthropic API (https://console.anthropic.com) - used only for the Stage 5
# sub-agent (vision sanity-check + rationale on the already-filtered shortlist)
ANTHROPIC_API_KEY=

# Mapbox Static Images API (https://account.mapbox.com) - current satellite
# imagery for the Stage 5 vision sanity-check. Free tier is plenty for a
# handful of shortlisted candidates per week.
MAPBOX_API_KEY=

# Local Postgres (matches docker-compose.yml); Railway will inject its own
# DATABASE_URL in production.
DATABASE_URL=postgresql://canopy:canopy@localhost:5433/canopy

# Gmail SMTP for weekly digest delivery. Use an app password, not your
# normal account password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO_EMAIL=

# Comma-separated list of target New Hanover County zip codes.
TARGET_ZIPS=28403,28405,28409,28412,28428,28449
